{
  "name": "OpenForum MVP",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "OpenForum",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteEnv": {
    "DJANGO_DEBUG": "1",
    "DJANGO_SECRET_KEY": "codespaces-dev-insecure-key",
    "DJANGO_ALLOWED_HOSTS": ".app.github.dev,localhost,127.0.0.1"
  },
  "postCreateCommand": "pip install -r requirements.txt && python tools/build_locales.py && mkdir -p data && python manage.py migrate && python manage.py createcachetable && python manage.py seed_demo --demo",
  "postAttachCommand": "python manage.py runserver 0.0.0.0:8000",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "batisteo.vscode-django",
        "monosans.djlint"
      ]
    }
  }
}
