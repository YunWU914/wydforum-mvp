# Copy to .env for bare-metal runs, or let docker compose interpolate these.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# For public deployments also set:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://forum.example.com
# DJANGO_SECURE_SSL_REDIRECT=1

SITE_NAME=OpenForum
SITE_TAGLINE=A place to ask, share and build together.
SITE_URL=http://localhost:8000

# --- Anti-abuse ---------------------------------------------------------------
# none | turnstile | recaptcha  (Turnstile: https://dash.cloudflare.com -> Turnstile)
CAPTCHA_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Set to 1 only behind a trusted reverse proxy (Caddy/nginx).
TRUST_X_FORWARDED_FOR=0

# --- Email --------------------------------------------------------------------
# Console backend prints activation links to stdout (great for local dev).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OpenForum <no-reply@example.com>
EMAIL_VERIFICATION_TTL_HOURS=48

# --- Optional bootstrap admin ---------------------------------------------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Demo content (dev only) ---------------------------------------------------
SEED_DEMO=1
